{
  "manifest_version": 3,
  "name": "Gemini Notebook Prompt Queue",
  "version": "1.0.2",
  "description": "Queue prompts for Gemini Notebook and auto-run them while you're away. Walk away, come back to a notebook full of answers.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://notebook.google.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://notebook.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
